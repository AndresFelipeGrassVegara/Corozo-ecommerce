// ─────────────────────────────────────────────────────────────
//  Esquema de base de datos de Coroso
//
//  Desarrollo: SQLite (archivo prisma/dev.db).
//  Producción: cambia `provider` a "postgresql" y ajusta DATABASE_URL.
//
//  Tras modificar este archivo ejecuta:  npm run db:migrate
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Catálogo ────────────────────────────────────────────────

/// Familia de prendas: Jeans, Vestidos, Conjuntos...
model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  products    Product[]
}

/// Prenda que se muestra en la tienda.
/// Los precios se guardan en pesos colombianos (COP) como números enteros: 189900 = $189.900
model Product {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  name           String
  subtitle       String // Línea corta bajo el nombre ("100% Algodón orgánico")
  description    String
  material       String?
  care           String? // Instrucciones de cuidado
  price          Int // Precio en COP
  compareAtPrice Int? // Precio anterior en COP (para mostrar rebajas)
  badge          String? // Etiqueta sobre la foto ("Edición Limitada")
  isNew          Boolean  @default(false)
  isFeatured     Boolean  @default(false)
  isActive       Boolean  @default(true) // false = oculto en la tienda
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categoryId Int
  category   Category         @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  variants   ProductVariant[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String // Ruta relativa (/uploads/products/x.jpg) o URL absoluta
  alt       String
  position  Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// Combinación talla + color con su propio stock.
model ProductVariant {
  id         Int         @id @default(autoincrement())
  sku        String      @unique
  size       String
  color      String
  stock      Int         @default(0)
  productId  Int
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, size, color])
}

// ─── Usuarios ────────────────────────────────────────────────

/// role: "ADMIN" | "CUSTOMER"  (ver src/auth/roles.ts)
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("CUSTOMER")
  createdAt    DateTime @default(now())
}

// ─── Pedidos ─────────────────────────────────────────────────

/// Pedido solicitado desde la bolsa. El cliente lo termina de coordinar por WhatsApp.
/// status: "PENDING" (solicitado) | "CONFIRMED" (stock descontado) | "DELIVERED" | "CANCELLED"
model Order {
  id           Int         @id @default(autoincrement())
  customerName String
  city         String
  notes        String?
  status       String      @default("PENDING")
  total        Int // Total en COP calculado en el servidor
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]

  @@index([status])
}

/// Copia ("snapshot") de los datos del producto en el momento del pedido,
/// para que el pedido no cambie si después se edita o borra la prenda.
model OrderItem {
  id          Int             @id @default(autoincrement())
  orderId     Int
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   Int?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  size        String
  color       String
  unitPrice   Int // Precio unitario en COP
  quantity    Int

  @@index([orderId])
}

// ─── Marketing ───────────────────────────────────────────────

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}
