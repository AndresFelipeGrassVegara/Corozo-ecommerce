# ─── Servidor ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# ─── Base de datos ───────────────────────────────────────────
# Desarrollo: SQLite (archivo local, no requiere instalar nada).
# Producción: cambia el provider en prisma/schema.prisma a "postgresql" y usa
#   DATABASE_URL="postgresql://usuario:clave@host:5432/coroso?schema=public"
DATABASE_URL="file:./dev.db"

# ─── Autenticación ───────────────────────────────────────────
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_HOURS=8

# ─── Administrador inicial (solo lo usa el seed) ─────────────
ADMIN_EMAIL=admin@coroso.com
ADMIN_PASSWORD=CambiaEsta.Clave2025
